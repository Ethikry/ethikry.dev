---
import Site from '../layouts/Site.astro'
---

<Site title="Not found" description="There’s nothing at this address.">
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This page doesn’t exist.</h1>
      <p class="lead">It may have moved, or the link might be off by a character.</p>
      <div class="btn-row">
        <a class="btn primary" href="/">Go home</a>
        <a class="btn" href="/projects/">See my work</a>
      </div>
    </div>
  </section>
</Site>
